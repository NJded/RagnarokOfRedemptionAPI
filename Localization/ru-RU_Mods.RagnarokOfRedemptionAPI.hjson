	BurningGrace: {
		DisplayName: Пылающая благодать
		Tooltip:
			'''
			Увеличивает урон и сопротивление {0} на 15%
			Увеличивает шанс критического удара {0} и {1} на 6%
			Эффекты суммируются при наличии обоих элементов
			Критические удары элементальным оружием {0} могут высвободить самонаводящуюся светомассу
			При использовании элементального оружия {1} или {0} вас окружает аура священного пламени
			Увеличивает длительность неуязвимости после получения урона
			Увеличивает сопротивление урону на {0}%, если вы не получали урона в течение {1} секунд
			Этот бонус пропадает при получении удара
			'''
	}

	CoreOfVirulence: {
		DisplayName: Ядро вирулентности
		Tooltip:
			'''
			Ваше сердце бьётся в ритме [cbuff:CalamityMod/Plague] и [cbuff:Redemption/BileDebuff], пульсируя снаружи вашего тела
			Периодически излучает энергию, которая высасывает здоровье из врагов, находящихся под действием дебаффов
			Частота пульсации зависит от регенерации; пульсации, убивающие врагов, исцеляют вас
			Увеличивает урон всех накладываемых игроком истощающих дебаффов на 50%
			Увеличивает сопротивление {0} на 25%
			Увеличивает урон {0} на 15%
			Эффекты становятся прозрачными и беззвучными, если отображение аксессуара отключено
			'То что нас не убивает - мутирует и пытается снова'
			'''
	}

	RootOfTheEvil: {
		DisplayName: Корень зла
		Tooltip:
			'''
			Любое элементальное оружие {0} и {3} получает элементы {1} и {2}
			Ваше оружие {1} становится эффективнее против врагов тьмы
			Ваше оружие {2} становится эффективнее против врагов крови
			Увеличивает урон и сопротивление {1}, {2} и {3} на 15%
			'''
	}

